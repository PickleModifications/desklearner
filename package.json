{
  "name": "desklearner",
  "version": "1.0.0",
  "description": "A modern way to learn on your desktop. Fully offline course reader with chapters, lessons and tests.",
  "main": "./out/main/index.js",
  "author": "DeskLearner",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "postinstall": "electron-builder install-app-deps",
    "package": "npm run build && electron-builder --win --publish never",
    "package:dir": "npm run build && electron-builder --win --dir --publish never"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "^37.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^4.0.0",
    "katex": "^0.16.22",
    "lucide-react": "^1.29.0",
    "mermaid": "^11.9.0",
    "minisearch": "^7.1.2",
    "prettier": "^3.6.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.6.3",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^3.7.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "unist-util-visit": "^5.0.0",
    "vite": "^7.0.0",
    "yaml": "^2.8.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.6"
  }
}
